{
  "name": "soundcloud-player",
  "version": "2.0.0",
  "description": "SoundCloud Desktop Player",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:miniapp && electron-builder",
    "build:all": "electron-vite build && npm run build:miniapp && electron-builder --linux AppImage --win portable",
    "preview": "electron-vite preview",
    "build:miniapp": "vite build --config vite.miniapp.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "lamejs": "^1.2.1",
    "mpris-service": "^2.1.2",
    "onnxruntime-node": "^1.31.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0",
    "zustand": "^5.0.1"
  },
  "build": {
    "appId": "com.soundcloud.player",
    "productName": "SoundCloud",
    "afterPack": "build/afterPack.js",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "buildResources/tray_clean.png",
        "to": "tray_clean.png"
      },
      {
        "from": "buildResources/icon_rounded.ico",
        "to": "icon_rounded.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "buildResources/icon_rounded.ico",
      "files": [
        "out/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
      ]
    },
    "linux": {
      "asar": false,
      "artifactName": "${productName}.${version}.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "buildResources/icon.png",
      "files": [
        "out/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**"
      ]
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ]
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  }
}
