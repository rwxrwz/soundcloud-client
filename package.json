{
  "name": "soundcloud-player",
  "version": "1.3.8",
  "description": "SoundCloud Desktop Player",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:all": "electron-vite build && electron-builder --linux AppImage --win portable",
    "preview": "electron-vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "jimp": "^1.6.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "to-ico": "^1.1.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "color-thief-browser": "^2.0.2",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.3",
    "lamejs": "^1.2.1",
    "mpris-service": "^2.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.1"
  },
  "build": {
    "appId": "com.soundcloud.player",
    "productName": "SoundCloud",
    "afterPack": "build/afterPack.js",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "buildResources/tray_clean.png",
        "to": "tray_clean.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "buildResources/icon_rounded.ico"
    },
    "linux": {
      "asar": false,
      "artifactName": "${productName}.${version}.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "buildResources/icon.png"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true
  }
}
